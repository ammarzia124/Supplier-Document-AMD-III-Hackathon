# .env.example
# Environment variables for Supplier Document Desk
# ------------------------------------------------------------------
# Server configuration
PORT=3000
# Absolute, externally reachable base URL. Evolus calls this back for
# webhooks, so it must NOT be "localhost" when running in a container or on
# a remote host, or the callback never arrives and the poller takes over.
PUBLIC_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# MongoDB connection
MONGODB_URI=mongodb://localhost:27017/supplier-docs

# Evolus REST API Configuration
EVOLUS_BASE_URL=https://api.evolus.ai/api/v1
EVOLUS_API_KEY=YOUR_EVOLUS_API_KEY
EVOLUS_APPLICATION_ID=YOUR_APPLICATION_ID
EVOLUS_WORKFLOW_ID=YOUR_WORKFLOW_ID
# REQUIRED. The webhook endpoint fails closed with 503 when this is unset,
# because an unauthenticated webhook lets anyone rewrite a document's
# fields, issues and status.
EVOLUS_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET
# "mock" replays fixtures from backend/fixtures; "prod" calls the live API.
EVOLUS_MODE=mock

# vLLM / OpenAI-compatible Endpoint (AMD / local / edge)
# The client appends /chat/completions automatically.
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=YOUR_VLLM_API_KEY
VLLM_MODEL=meta-llama/Llama-3.2-1B-Instruct
# Request timeout in milliseconds.
VLLM_TIMEOUT_MS=30000
# Optional. USD per 1000 tokens, used to compute costEstimate per document.
# Leave at 0 to report cost as null rather than inventing a figure.
VLLM_USD_PER_1K_TOKENS=0

# Business Rules Policy Thresholds
# A malformed value falls back to the default rather than silently disabling
# the control.
CONFIDENCE_MIN=0.90
AMOUNT_RISK_LIMIT=5000

# Logging
LOG_LEVEL=info