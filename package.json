{
  "name": "supplier-document-desk",
  "version": "0.1.0",
  "description": "Supplier Document Desk - AI-powered invoice & delivery-note validation",
  "main": "backend/src/index.js",
  "scripts": {
    "start": "node backend/src/server.js",
    "dev": "node --watch backend/src/server.js",
    "test": "jest",
    "mock": "node mocks/server.js",
    "seed": "npm --prefix backend run seed",
    "check:evolus": "npm --prefix backend run check:evolus",
    "check:vllm": "npm --prefix backend run check:vllm",
    "batch": "node scripts/run_batch.js",
    "eval": "node scripts/compute_eval.js",
    "eval:run": "python ai/eval/run_eval.py",
    "eval:test": "python -m unittest discover -s ai/eval -p test_run_eval.py"
  },
  "author": "Ammar",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^6.7.0",
    "form-data": "^4.0.0",
    "mongoose": "^8.5.4",
    "multer": "^1.4.5-lts.1",
    "pino": "^9.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  }
}